{
  "name": "mcp-shield",
  "displayName": "MCP Shield",
  "description": "A security-first middleware gateway and policy enforcer for Model Context Protocol (MCP) servers.",
  "version": "0.2.0",
  "publisher": "cybersecurity",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Security",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "security",
    "ai agent",
    "prompt injection"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mcp-shield.openDashboard",
        "title": "Open Security Dashboard",
        "category": "MCP Shield"
      },
      {
        "command": "mcp-shield.scanConfigs",
        "title": "Scan for MCP Configurations",
        "category": "MCP Shield"
      },
      {
        "command": "mcp-shield.runAttackDemo",
        "title": "Run Attack Simulation",
        "category": "MCP Shield"
      },
      {
        "command": "mcp-shield.revokeAllRules",
        "title": "Revoke All Standing Approvals",
        "category": "MCP Shield"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcp-shield-container",
          "title": "MCP Shield",
          "icon": "resources/shield-icon.svg"
        }
      ]
    },
    "views": {
      "mcp-shield-container": [
        {
          "id": "mcp-shield-sidebar",
          "name": "Shielded Servers",
          "icon": "resources/shield-icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mcp-shield.scanConfigs",
          "when": "view == mcp-shield-sidebar",
          "group": "navigation"
        },
        {
          "command": "mcp-shield.openDashboard",
          "when": "view == mcp-shield-sidebar",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MCP Shield",
      "properties": {
        "mcpShield.databasePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the MCP Shield policy and audit database. Leave empty to use the extension's global storage, which keeps one database and one approval channel across all workspaces. A relative path is resolved against the first workspace folder.\n\n**Note:** the absolute path is written into your MCP client's configuration when a server is shielded, so changing this after shielding requires re-shielding those servers."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "vsce package"
  },
  "dependencies": {
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^18.11.18",
    "@types/sqlite3": "^3.1.11",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.17.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^4.9.4"
  }
}
