{
  "name": "mcp-shield",
  "displayName": "MCP Shield",
  "description": "A Security-First Middleware Gateway and Policy Enforcer for Model Context Protocol (MCP) servers.",
  "version": "0.1.0",
  "publisher": "cybersecurity",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Security",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mcp-shield.openDashboard",
        "title": "MCP Shield: Open Security Dashboard",
        "category": "MCP Shield"
      },
      {
        "command": "mcp-shield.scanConfigs",
        "title": "MCP Shield: Scan and Shield MCP Configs",
        "category": "MCP Shield"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcp-shield-container",
          "title": "MCP Shield",
          "icon": "resources/shield-icon.svg"
        }
      ]
    },
    "views": {
      "mcp-shield-container": [
        {
          "type": "webview",
          "id": "mcp-shield-sidebar",
          "name": "Shield Overview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.js",
    "test": "jest",
    "postinstall": "node -e \"console.log('Postinstall complete')\""
  },
  "dependencies": {
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^18.11.18",
    "@types/sqlite3": "^3.1.11",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.17.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^4.9.4"
  }
}
